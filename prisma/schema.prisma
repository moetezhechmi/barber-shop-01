generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  image     String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())

  shops         Shop[]
  barberProfile Barber?
  appointments  Appointment[]
  reviews       Review[]
  notifications Notification[]
  orders        Order[]
  loyaltyCard   LoyaltyCard?

  @@index([role])
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String
  phone       String?
  email       String?
  image       String?
  facebook    String?
  instagram   String?
  tiktok      String?
  isAvailable Boolean  @default(true)
  images      String[] @default([])
  amenities   String[] @default([])
  ownerId     String
  createdAt   DateTime @default(now())

  owner        User           @relation(fields: [ownerId], references: [id])
  barbers      Barber[]
  services     Service[]
  workingHours WorkingHours[]
  appointments Appointment[]
  reviews      Review[]
  promotions   Promotion[]
  products     Product[]
  orders       Order[]

  @@index([ownerId])
  @@index([isAvailable])
}

model Barber {
  id         String   @id @default(cuid())
  userId     String   @unique
  shopId     String?
  bio        String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  user         User           @relation(fields: [userId], references: [id])
  shop         Shop?          @relation(fields: [shopId], references: [id])
  workingHours WorkingHours[]
  timeSlots    TimeSlot[]
  appointments Appointment[]
  reviews      Review[]
  gallery      GalleryImage[]

  @@index([userId])
  @@index([shopId])
}

model Service {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  price       Float
  duration    Int
  createdAt   DateTime @default(now())

  shop         Shop          @relation(fields: [shopId], references: [id])
  appointments Appointment[]

  @@index([shopId])
}

model WorkingHours {
  id          String  @id @default(cuid())
  barberId    String?
  shopId      String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)

  barber Barber? @relation(fields: [barberId], references: [id])
  shop   Shop?   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([barberId])
  @@index([dayOfWeek])
}

model TimeSlot {
  id        String  @id @default(cuid())
  barberId  String
  date      String
  startTime String
  endTime   String
  isBooked  Boolean @default(false)

  barber Barber @relation(fields: [barberId], references: [id])

  @@index([barberId])
  @@index([date])
  @@index([isBooked])
}

model Appointment {
  id        String   @id @default(cuid())
  clientId  String
  barberId  String
  shopId    String
  serviceId String
  date      String
  startTime String
  endTime   String
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())

  client  User    @relation(fields: [clientId], references: [id])
  barber  Barber  @relation(fields: [barberId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  review  Review?

  @@index([clientId])
  @@index([barberId])
  @@index([shopId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
}

model Review {
  id            String   @id @default(cuid())
  clientId      String
  barberId      String
  shopId        String
  appointmentId String   @unique
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  client      User        @relation(fields: [clientId], references: [id])
  barber      Barber      @relation(fields: [barberId], references: [id])
  shop        Shop        @relation(fields: [shopId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([clientId])
  @@index([barberId])
  @@index([shopId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  barberId  String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id])

  @@index([barberId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  message       String
  type          String
  isRead        Boolean  @default(false)
  appointmentId String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

model Promotion {
  id          String   @id @default(cuid())
  shopId      String
  title       String
  description String?
  discount    Int // Percentage discount (e.g., 20 for 20% off)
  startDate   String // Format: YYYY-MM-DD
  endDate     String // Format: YYYY-MM-DD
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([isActive])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  image       String?
  category    String   @default("Soins") // Barbe, Cheveux, Soins, Accessoires
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  shop       Shop        @relation(fields: [shopId], references: [id])
  orderItems OrderItem[]

  @@index([shopId])
  @@index([isAvailable])
  @@index([category])
}

model Order {
  id        String   @id @default(cuid())
  shopId    String
  clientId  String
  status    String   @default("PENDING") // PENDING, READY, COMPLETED, CANCELLED
  total     Float
  notes     String?
  createdAt DateTime @default(now())

  shop   Shop        @relation(fields: [shopId], references: [id])
  client User        @relation(fields: [clientId], references: [id])
  items  OrderItem[]

  @@index([shopId])
  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model LoyaltyCard {
  id                         String   @id @default(cuid())
  clientId                   String   @unique
  stamps                     Int      @default(0)
  totalEarned                Int      @default(0)
  cardsCompleted             Int      @default(0)
  lastCompletedAppointmentId String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])
}
